<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>3.0.0</version>
        <id>datatables.net-searchpanes</id>
        <description>This is SearchPanes for DataTables</description>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>http://datatables.net</projectUrl>
        <license type="file">License.txt</license>
        <tags>SearchPanes  search  filtering  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net" version="[3.1.0, 4.0.0)"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/dataTables.searchPanes.js" target="content\Scripts"/>
        <file src="js/dataTables.searchPanes.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/dataTables.searchPanes.min.js" target="content\Scripts"/>
        <file src="js/dataTables.searchPanes.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/dataTables.searchPanes.min.mjs" target="content\Scripts"/>
        <file src="js/dataTables.searchPanes.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/dataTables.searchPanes.mjs" target="content\Scripts"/>
        <file src="js/dataTables.searchPanes.mjs" target="contentFiles\any\any\wwwroot\js"/>
    </files>
</package>
